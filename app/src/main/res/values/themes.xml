<resources>
    <!-- Base application theme: Modern Dark Mode -->
    <style name="Theme.SubKiller" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/primary_neon_green</item>
        <item name="colorOnPrimary">#000000</item>
        <item name="colorSecondary">@color/primary_neon_green</item>
        <item name="colorOnSecondary">#000000</item>
        <item name="colorError">@color/danger_red</item>
        <item name="colorOnError">#FFFFFF</item>
        <item name="android:windowBackground">@color/bg_dark</item>
        <item name="android:colorBackground">@color/bg_dark</item>
        <item name="colorSurface">@color/card_dark</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="android:statusBarColor">@color/bg_dark</item>
        <item name="android:navigationBarColor">@color/bg_dark</item>
    </style>

    <!-- 24dp Rounded Corner Shape -->
    <style name="ShapeAppearance.SubKiller.Card" parent="ShapeAppearance.Material3.MediumComponent">
        <item name="cornerSize">24dp</item>
    </style>
</resources>
